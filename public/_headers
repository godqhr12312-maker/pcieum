# Static Assets are served before the Worker. Keep browser HTML caching out of
# this file; the Worker checks anonymous/public eligibility and rotates CSP nonces.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# This subtree is reserved by Vinext for content-addressed build output.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames include a content hash; license/source notes do not match.
/fonts/noto-sans-kr-v40-*
  Cache-Control: public, max-age=31536000, immutable

# Explicit content-hashed public asset; stable filenames must revalidate.
/hero.93b030a133d9.jpg
  Cache-Control: public, max-age=31536000, immutable

/hero.jpg
  Cache-Control: public, max-age=0, must-revalidate

/logo.png
  Cache-Control: public, max-age=0, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate
